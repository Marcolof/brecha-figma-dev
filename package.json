{
  "name": "brecha-hub",
  "private": true,
  "version": "0.1.0",
  "description": "Hub de la brecha Figma ↔ web de Correo Argentino: auditoría, planes y handoff del design system.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
